{
  "name": "helvetic-ops-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "CI=true ng test",
    "e2e": "playwright test",
    "e2e:auth:dispatcher": "node ../scripts/e2e-auth-setup.js dispatcher",
    "e2e:auth:manager": "node ../scripts/e2e-auth-setup.js manager",
    "e2e:screenshots": "playwright test e2e/screenshot-capture.spec.ts",
    "api:generate": "nswag run nswag.json",
    "api:check": "sh -c 'temporary=src/app/api/generated/work-orders-api.check.ts; trap \"rm -f $temporary\" EXIT; nswag run nswag.json /variables:Output=$temporary; cmp -s src/app/api/generated/work-orders-api.ts $temporary'",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@azure/msal-angular": "^6.0.2",
    "@azure/msal-browser": "^5.17.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.62.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.37.0",
    "jsdom": "^27.4.0",
    "nswag": "^14.7.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.3"
    },
    "@hono/node-server": "^2.0.5"
  }
}
